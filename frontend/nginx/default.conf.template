# Rendered at container start by the nginx image (envsubst replaces only defined variables: ${BACKEND_URL}).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same origin for the browser: API calls go through this server, so the backend needs no CORS.
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v3/api-docs {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
    }

    location /swagger-ui {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
    }

    # Fingerprinted build output (main-XXXX.js, chunk-XXXX.js) never changes: cache for a year.
    location ~* \.(?:js|css|woff2?|ico|svg|png)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths (e.g. /projects/123) are client-side routes served by index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
